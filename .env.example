# Copy to project-root .env and enter values locally. This file has no credentials.
# Never commit .env. Hosted secrets belong in your provider's server environment UI.

# Local dashboard mode (default). Requires Node.js 24+.
CONTROL_UNIT_MODE=local
PORT=4310
TIMEZONE=Asia/Karachi
IMPORT_INTERVAL_SECONDS=60
# RIO_HOME=/absolute/path/to/rios/home
# DATA_DIR=/absolute/path/to/control-unit-data
# INBOX_DIR=/absolute/path/to/agent-inbox

# Optional local analysis and local ingestion protection.
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_DAILY_CALL_LIMIT=20
INGESTION_TOKEN=

# Optional individual source path overrides. ~/ uses RIO_HOME.
# RIO_APPLICATIONS_PATH=/path/to/applied-log.md
# RIO_OPPORTUNITIES_PATH=/path/to/OPPORTUNITY-LEDGER.md
# RIO_WORKBOOK_PATH=/path/to/opportunity-tracker.xlsx
# RIO_LINKEDIN_PATH=/path/to/linkedin/log.md
# RIO_DENTAL_PATH=/path/to/cash-track/log.md
# RIO_SOCIAL_PATH=/path/to/deliveries/*/PLAN.md
# RIO_MEMORY_PATH=/path/to/memory/????-??-??.md

# Hosted server settings. Enter these only in the provider's server environment UI.
# Set CONTROL_UNIT_MODE=hosted when deploying; replace the empty values there.
# APP_ORIGIN=https://your-canonical-site.example
# CONTROL_UNIT_MODE=hosted
APP_ORIGIN=
DATABASE_URL=
DASHBOARD_PASSWORD=
SESSION_SECRET=
# Hosted INGESTION_TOKEN must be a random value of at least 32 characters.
# OPENAI_API_KEY is optional; LLM_MODEL and LLM_DAILY_CALL_LIMIT also apply hosted.

# Collector machine settings. Set these in that machine's local .env only.
# CONTROL_UNIT_URL=https://your-canonical-site.example
# INGESTION_TOKEN=  # same token as hosted server; enter locally, never commit
# COLLECTOR_ID=rio-primary
